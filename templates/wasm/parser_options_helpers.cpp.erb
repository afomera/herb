#include "parser_options_helpers.h"

void herb_extract_parser_options(emscripten::val options, parser_options_T* parser_options) {
  if (options.isUndefined() || options.isNull() || options.typeOf().as<std::string>() != "object") { return; }

<%- parser_options.extractable_fields_for(:javascript).each do |field| -%>
<%- if field.boolean? -%>
  if (options.hasOwnProperty("<%= field.snake_case %>")) {
    parser_options-><%= field.c_name %> = options["<%= field.snake_case %>"].as<bool>();
  }

<%- elsif field.enum? -%>
  if (options.hasOwnProperty("<%= field.snake_case %>") && options["<%= field.snake_case %>"].isString()) {
    std::string value = options["<%= field.snake_case %>"].as<std::string>();
    <%= field.c_enum_from_string %>(value.c_str(), value.size(), &parser_options-><%= field.c_name %>);
  }

<%- elsif field.nullable? -%>
  if (options.hasOwnProperty("<%= field.snake_case %>")) {
    emscripten::val value = options["<%= field.snake_case %>"];
    parser_options-><%= field.c_name %> = value.isNull() ? <%= field.null_sentinel %> : (uint32_t) value.as<int>();
  }

<%- else -%>
  if (options.hasOwnProperty("<%= field.snake_case %>")) {
    parser_options-><%= field.c_name %> = (uint32_t) options["<%= field.snake_case %>"].as<int>();
  }

<%- end -%>
<%- end -%>
}
