#include "parser_options_helpers.h"

void herb_extract_parser_options(VALUE options, parser_options_T* parser_options) {
  if (NIL_P(options)) { return; }
<%- parser_options.extractable_fields_for(:ruby).each do |field| -%>

<%- if field.boolean? -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = RTEST(value); }
  }
<%- elsif field.enum? -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }

    if (!NIL_P(value)) {
      if (SYMBOL_P(value)) { value = rb_sym2str(value); }
      if (!RB_TYPE_P(value, T_STRING)) { rb_raise(rb_eTypeError, "<%= field.snake_case %> must be a String or Symbol"); }

      if (!<%= field.c_enum_from_string %>(RSTRING_PTR(value), (size_t) RSTRING_LEN(value), &parser_options-><%= field.c_name %>)) {
        rb_raise(
          rb_eArgError,
          "invalid <%= field.snake_case %>: %" PRIsVALUE " (expected one of: <%= field.values.join(", ") %>)",
          value
        );
      }
    }
  }
<%- elsif field.string_map? -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }

    if (!NIL_P(value)) {
      // Points into the Hash's strings, which stay alive (and can't move: parsing doesn't allocate Ruby objects)
      // until the parse returns.
      static hb_string_T pairs[<%= field.c_name.upcase %>_MAX_ENTRIES * 2];

      Check_Type(value, T_HASH);

      if (RHASH_SIZE(value) > <%= field.c_name.upcase %>_MAX_ENTRIES) {
        rb_raise(rb_eArgError, "<%= field.snake_case %> accepts at most %d entries", <%= field.c_name.upcase %>_MAX_ENTRIES);
      }

      VALUE keys = rb_funcall(value, rb_intern("keys"), 0);
      long count = RARRAY_LEN(keys);

      for (long index = 0; index < count; index++) {
        VALUE key = rb_ary_entry(keys, index);
        VALUE entry = rb_hash_aref(value, key);

        if (SYMBOL_P(key)) { key = rb_sym2str(key); }
        if (SYMBOL_P(entry)) { entry = rb_sym2str(entry); }

        if (!RB_TYPE_P(key, T_STRING) || !RB_TYPE_P(entry, T_STRING)) {
          rb_raise(rb_eTypeError, "<%= field.snake_case %> keys and values must be Strings or Symbols");
        }

        pairs[index * 2] = hb_string_from_data(RSTRING_PTR(key), (uint32_t) RSTRING_LEN(key));
        pairs[index * 2 + 1] = hb_string_from_data(RSTRING_PTR(entry), (uint32_t) RSTRING_LEN(entry));
      }

      parser_options-><%= field.c_name %> = pairs;
      parser_options-><%= field.count_name %> = (size_t) count;
    }
  }
<%- elsif field.ruby_unit == "seconds" -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = (uint32_t) (NUM2DBL(value) * 1000); }
  }
<%- elsif field.nullable? -%>
  {
    VALUE sentinel = ID2SYM(rb_intern("__not_set__"));
    VALUE value = rb_hash_lookup2(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"), sentinel);
    if (value == sentinel) { value = rb_hash_lookup2(options, ID2SYM(rb_intern("<%= field.snake_case %>")), sentinel); }

    if (value != sentinel) { parser_options-><%= field.c_name %> = NIL_P(value) ? <%= field.null_sentinel %> : (uint32_t) NUM2UINT(value); }
  }
<%- else -%>
  {
    VALUE value = rb_hash_lookup(options, rb_utf8_str_new_cstr("<%= field.snake_case %>"));
    if (NIL_P(value)) { value = rb_hash_lookup(options, ID2SYM(rb_intern("<%= field.snake_case %>"))); }
    if (!NIL_P(value)) { parser_options-><%= field.c_name %> = (uint32_t) NUM2UINT(value); }
  }
<%- end -%>
<%- end -%>
}

VALUE herb_build_parser_options_hash(const parser_options_T* options) {
  VALUE kwargs = rb_hash_new();

<%- parser_options.fields_for(:c).each do |field| -%>
<%- if field.boolean? -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), options-><%= field.c_name %> ? Qtrue : Qfalse);
<%- elsif field.string_array? -%>
  {
    VALUE <%= field.snake_case %> = rb_ary_new_capa((long) options-><%= field.count_name %>);

    for (size_t index = 0; index < options-><%= field.count_name %>; index++) {
      hb_string_T item = options-><%= field.c_name %>[index];

      rb_ary_push(<%= field.snake_case %>, rb_utf8_str_new(item.data, (long) item.length));
    }

    rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), <%= field.snake_case %>);
  }
<%- elsif field.string_map? -%>
  {
    VALUE <%= field.snake_case %> = rb_hash_new();

    for (size_t index = 0; index < options-><%= field.count_name %>; index++) {
      hb_string_T key = options-><%= field.c_name %>[index * 2];
      hb_string_T value = options-><%= field.c_name %>[index * 2 + 1];

      rb_hash_aset(<%= field.snake_case %>, rb_utf8_str_new(key.data, (long) key.length), rb_utf8_str_new(value.data, (long) value.length));
    }

    rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), <%= field.snake_case %>);
  }
<%- elsif field.enum? -%>
  rb_hash_aset(
    kwargs,
    ID2SYM(rb_intern("<%= field.snake_case %>")),
    rb_utf8_str_new_cstr(<%= field.c_enum_to_string %>(options-><%= field.c_name %>))
  );
<%- elsif field.ruby_unit == "seconds" -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), DBL2NUM((double) options-><%= field.c_name %> / 1000.0));
<%- elsif field.nullable? -%>
  rb_hash_aset(
    kwargs,
    ID2SYM(rb_intern("<%= field.snake_case %>")),
    options-><%= field.c_name %> == <%= field.null_sentinel %> ? Qnil : UINT2NUM(options-><%= field.c_name %>)
  );
<%- else -%>
  rb_hash_aset(kwargs, ID2SYM(rb_intern("<%= field.snake_case %>")), UINT2NUM(options-><%= field.c_name %>));
<%- end -%>
<%- end -%>

  return kwargs;
}
